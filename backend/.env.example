# Steward Backend - Konfiguration
#
# Zum Entwickeln: Datei nach ".env" kopieren und ausfuellen (.env ist in .gitignore)
# Am Server: Inhalt nach /etc/steward/steward.env, dort gehoert er root und ist
#            nur fuer die Gruppe steward lesbar (chmod 640) - so liegt der Key
#            nicht im Projektordner und kann nicht versehentlich mitgepusht werden

# --- Zugriff von App und PC auf das Backend ---
# Erzeugen mit: openssl rand -hex 32
STEWARD_API_KEY=

# --- Modell-Auswahl: "claude" oder "ollama" ---
STEWARD_LLM=claude

# --- Claude API (nur noetig wenn STEWARD_LLM=claude) ---
# Eigener Key nur fuer Steward, damit er einzeln widerrufbar ist
ANTHROPIC_API_KEY=
CLAUDE_MODELL_STANDARD=claude-haiku-4-5-20251001
CLAUDE_MODELL_GROSS=claude-sonnet-5

# --- Ollama (nur noetig wenn STEWARD_LLM=ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELL=llama3.1:8b

# --- Kostenbremse ---
# Harte Obergrenzen im Code, unabhaengig vom Spending-Limit in der Console
# 2 Mio Token Haiku entsprechen grob 2 bis 10 Euro - bewusst hoch als Reissleine,
# nicht als Alltagsgrenze
STEWARD_TOKENBUDGET_PRO_TAG=2000000
STEWARD_TOKENBUDGET_PRO_LAUF=200000

# --- Betrieb ---
# Am Server MUSS das ein absoluter Pfad in /opt/steward/daten sein: die systemd-Unit
# erlaubt mit ProtectSystem=strict nur dort das Schreiben. Ein relativer Pfad landet
# im Projektordner, und dann startet der Dienst nicht
#   am Server:     /opt/steward/daten/steward.db
#   beim Entwickeln: steward.db (relativ ist hier in Ordnung)
STEWARD_DB_PFAD=steward.db
STEWARD_ZEITZONE=Europe/Vienna
# Planer abdrehen (praktisch beim Entwickeln, damit nichts von selbst losrennt)
STEWARD_PLANER_AN=true
# Swagger-Oberflaeche unter /docs - im Betrieb aus lassen
STEWARD_SWAGGER_AN=false
